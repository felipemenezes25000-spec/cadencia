# Conexao administrativa: roda migrations. Local = superusuario do container.
DATABASE_URL_ADMIN=postgres://postgres@localhost:5433/cadencia
# Conexao da aplicacao: papel `api`, sujeito a RLS, sem posse de relacao.
DATABASE_URL=postgres://api@localhost:5433/cadencia
# Conexao dos jobs internos: papel `jobs`, UNICO com BYPASSRLS.
DATABASE_URL_JOBS=postgres://jobs@localhost:5433/cadencia

# Chave AES-256-GCM que cifra o segredo TOTP em repouso. 32 bytes em base64.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Em producao vem do Secrets Manager, nunca de arquivo.
CADENCIA_TOTP_KEY=

# Chave SEPARADA para tokens OAuth/API persistidos (Google Calendar etc.).
# Tambem 32 bytes aleatorios em base64. Nao reutilize CADENCIA_TOTP_KEY:
# rotacionar credencial de integracao nao deve invalidar o MFA da equipe.
CADENCIA_INTEGRATION_TOKEN_KEY=

# Provedores:
# fake  = tudo simulado (desenvolvimento/teste)
# memed = Memed real; demais integrações operacionais simuladas
# real  = WhatsApp Cloud, Twilio SMS, Asaas, BirdID e demais adapters reais
CADENCIA_PROVIDERS=fake

# --- Prescricao Memed ------------------------------------------------------
# NUNCA use chave de producao em ambiente local. Para desenvolvimento integrado
# use homologacao. A base JA inclui /v1.
MEMED_BASE_URL=
MEMED_SCRIPT_URL=
MEMED_API_KEY=
MEMED_SECRET_KEY=

# --- Assinatura ICP-Brasil (BirdID) — obrigatoria em modo real ------------
BIRDID_CLIENT_ID=
BIRDID_CLIENT_SECRET=

# --- WhatsApp Cloud / Meta -------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Segredo usado para validar X-Hub-Signature-256 no POST do webhook.
WHATSAPP_APP_SECRET=
# Token do handshake GET (hub.verify_token).
WHATSAPP_VERIFY_TOKEN=

# --- SMS Twilio ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Origem PUBLICA exata cadastrada na Twilio, sem barra final.
# Ex.: https://api.cadencia.com.br
# A assinatura do webhook inclui a URL completa; em proxy/rewrite, definir esta
# origem evita validar a URL interna do container em vez da URL vista pela Twilio.
TWILIO_WEBHOOK_ORIGIN=

# --- Pagamentos Asaas ------------------------------------------------------
ASAAS_API_KEY=
# Token recebido no header asaas-access-token do webhook.
ASAAS_WEBHOOK_TOKEN=

# Compatibilidade do modo `memed`, que ainda usa o fake de pagamento com HMAC.
PSP_WEBHOOK_SECRET=

# --- Email transacional ----------------------------------------------------
# Opcional. Sem SMTP_HOST o sistema usa provider fake e continua operando.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Transcricao assistida -------------------------------------------------
# Opcional; sem chave a transcricao usa fake e nao bloqueia o atendimento.
OPENAI_API_KEY=

# --- CID-10 (CSV oficial DATASUS) -----------------------------------------
# Caminho do arquivo CID-10-SUBCATEGORIAS.CSV extraido de CID10CSV.ZIP.
# A carga e explicita (`pnpm cid10:load`) e nunca ocorre durante migration.
CID10_CSV_PATH=

# --- CID-11 (ICD-11 MMS da OMS) -------------------------------------------
# Usadas SO pelo script de carga (`scripts/carregar-cid11.ts`), nunca em
# caminho de requisicao.
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=
# Instancia local (pnpm icd:up). Para o servico publico, use https://id.who.int
# e preencha as credenciais acima.
ICD_BASE_URL=http://localhost:8081
