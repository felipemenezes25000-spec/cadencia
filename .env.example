# Conexao administrativa: roda migrations. Local = superusuario do container.
DATABASE_URL_ADMIN=postgres://postgres@localhost:5433/cadencia
# Conexao da aplicacao: papel `api`, sujeito a RLS, sem posse de relacao.
DATABASE_URL=postgres://api@localhost:5433/cadencia
# Conexao dos jobs internos: papel `jobs`, UNICO com BYPASSRLS.
DATABASE_URL_JOBS=postgres://jobs@localhost:5433/cadencia

# Chave AES-256-GCM que cifra o segredo TOTP em repouso. 32 bytes em base64.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Em producao vem do Secrets Manager, nunca de arquivo.
CADENCIA_TOTP_KEY=

# Prescricao (Memed). NUNCA use chave de PRODUCAO em ambiente local: a Memed nao
# tem "modo teste" na chave de producao, e uma prescricao emitida em teste e uma
# prescricao real, com efeito em farmacia. Para desenvolvimento use as chaves de
# HOMOLOGACAO. A chave de producao mora so no cofre da plataforma de deploy.
# fake  = tudo simulado (padrao de desenvolvimento)
# memed  = Memed REAL, resto simulado. Receita vale; atestado NAO tem valor
#          legal, porque a assinatura continua fake. Avisado no boot.
# real   = tudo que existe, real. A assinatura NAO vira fake: vira o provedor
#          que RECUSA, entao atestado sai explicitamente pendente em vez de sair
#          com estado `assinado` e sem valor legal. Exige os segredos de webhook
#          abaixo e nao sobe sem eles.
CADENCIA_PROVIDERS=fake
# Producao: https://api.memed.com.br/v1 · Homologacao: https://integrations.api.memed.com.br/v1
# A base JA INCLUI o /v1.
MEMED_BASE_URL=
# Producao:    https://partners.memed.com.br/integration.js
# Homologacao: https://integrations.memed.com.br/modulos/plataforma.sinapse-prescricao/build/sinapse-prescricao.min.js
# Os HOSTS sao diferentes, nao so o caminho — nao basta trocar api por integrations.
MEMED_SCRIPT_URL=
MEMED_API_KEY=
MEMED_SECRET_KEY=

# --- Segredos de webhook (obrigatorios com CADENCIA_PROVIDERS=real ou memed) --
# `POST /v1/payments/webhook` e `POST /v1/messaging/webhook/:channel` sao as
# duas rotas de escrita que NAO exigem sessao — quem chama e o PSP e a Meta, nao
# o navegador. A unica coisa que separa um evento legitimo de um forjado e o
# HMAC calculado com estes segredos, e um evento forjado marca lancamento como
# pago. Vazio aqui de proposito: em `fake` nao sao lidos, e nos outros modos o
# boot falha ate serem preenchidos. Em producao vem do cofre, nunca de arquivo.
PSP_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
# Token do handshake GET do webhook da Meta (hub.verify_token).
WHATSAPP_VERIFY_TOKEN=

# --- CID-11 (ICD-11 MMS da OMS) --------------------------------------------
# Usadas SO pelo script de carga (`scripts/carregar-cid11.ts`), nunca em
# caminho de requisicao. Registro gratuito em https://icd.who.int/icdapi.
# Licenca CC BY-ND 3.0 IGO: uso comercial permitido, atribuicao obrigatoria,
# PROIBIDO publicar versao derivada da classificacao — o produto pode exibir e
# pesquisar, nao pode mesclar com tabela interna nem republicar adaptada.
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=
# Em producao, aponte para uma instancia propria (container `whoicd/icd-api`):
# a carga nao pode depender do servidor da OMS estar de pe.
# Instancia local (pnpm icd:up). Sem OAuth: a OMS dispensa autenticacao no
# container proprio. Para usar o servico publico, troque por https://id.who.int
# e preencha as duas credenciais acima.
ICD_BASE_URL=http://localhost:8081
